 "tips": [
  {
   "nl": "Ambulance: 912. Politie en brandweer: 911. Kustwacht: 913. Spoednummer CMC: 910 (stuurt geen ambulance).",
   "en": "Ambulance: 912. Police and fire: 911. Coast Guard: 913. CMC emergency line: 910 (does not dispatch ambulances)."
  },
  {
   "nl": "Apotheken zijn meestal ma-za 8:00-19:00 open en op zondag dicht. 's Nachts zijn er minstens twee Botika na Warda open.",
   "en": "Pharmacies usually open Mon-Sat 8 am to 7 pm and close Sunday. At night at least two duty pharmacies (Botika na Warda) stay open."
  },
  {
   "nl": "Je EHIC/GHIC geldt niet op Curaçao. Neem een reisverzekering met dekking voor behandeling en repatriëring.",
   "en": "Your EHIC or GHIC card is not valid in Curaçao. Get travel insurance that covers treatment and medical evacuation."
  },
  {
   "nl": "Bij MedPoint betaal je ter plekke met pin en krijg je een medisch verslag en bon voor je verzekeraar.",
   "en": "At MedPoint you pay on the spot by card and get a medical report and receipt for your insurer."
  },
  {
   "nl": "In een resort? Bel eerst de receptie: die regelt vaak een arts.",
   "en": "Staying at a resort? Call the front desk first; they often arrange a doctor."
  }
 ],
 "faq": [
  {
   "q": {
    "nl": "Wat is het alarmnummer op Curaçao?",
    "en": "What is the emergency number in Curaçao?"
   },
   "a": {
    "nl": "912 voor een ambulance, 911 voor politie en brandweer, 913 voor de kustwacht en 917 voor de toeristenpolitie.",
    "en": "912 for an ambulance, 911 for police and fire, 913 for the Coast Guard and 917 for the tourist police."
   }
  },
  {
   "q": {
    "nl": "Waar ga je als toerist naar de dokter op Curaçao?",
    "en": "Where do tourists see a doctor in Curaçao?"
