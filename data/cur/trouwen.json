  }
 ],
 "faq": [
  {
   "q": {
    "nl": "Kun je als toerist wettig trouwen op Curaçao?",
    "en": "Can tourists legally marry in Curaçao?"
   },
   "a": {
    "nl": "Ja. Je stuurt een ondertekende brief met twee voorkeursdata naar de gemeente en levert de papieren minstens 2 maanden vooraf in bij de burgerlijke stand (Kranshi) in Willemstad.",
    "en": "Yes. You send a signed letter with two preferred dates to the municipality and file your documents with the civil registry (Kranshi) in Willemstad at least 2 months ahead."
   }
  },
  {
   "q": {
    "nl": "Welke papieren heb je nodig om op Curaçao te trouwen?",
    "en": "What documents do you need to marry in Curaçao?"
   },
   "a": {
    "nl": "Geboorteakten met namen van de ouders, een internationale verklaring van ongehuwd zijn met apostille, eventueel echtscheidingsvonnis of overlijdensakte, en kopieën van de paspoorten. Niet ouder dan 6 maanden; vertaling nodig als ze niet in het Nederlands, Engels of Spaans zijn.",
    "en": "Birth certificates listing your parents, an international certificate of no impediment with apostille, any divorce decree or death certificate, and passport copies. No older than 6 months; translate anything not in Dutch, English or Spanish."
   }
  },
  {
   "q": {
    "nl": "Wat kost trouwen op Curaçao?",
    "en": "How much does a Curaçao wedding cost?"
   },
   "a": {
    "nl": "Gemiddeld ongeveer $10.085 per stel volgens DestinationWeddings.com. Resortpakketten: $1.000-2.500 (basis), $3.500-6.000 (midden), $7.500-12.000+ (luxe). BeachBride noemt $10.000 tot $35.000.",
    "en": "About $10,085 per couple on average per DestinationWeddings.com. Resort packages: $1,000-2,500 (basic), $3,500-6,000 (mid), $7,500-12,000+ (high end). BeachBride cites $10,000 to $35,000."
   }
  },
  {
   "q": {
    "nl": "Hoeveel getuigen heb je nodig?",
    "en": "How many witnesses do you need?"
   },
   "a": {
    "nl": "Bij een wettige ceremonie buiten het gemeentehuis zes volwassen getuigen. Een eigen getuige moet minstens 21 zijn.",
    "en": "A legal ceremony outside the registry office needs six adult witnesses. Your own witness must be at least 21."
   }
  },
  {
   "q": {
    "nl": "Is een huwelijk op Curaçao geldig in de VS en Nederland?",
    "en": "Is a Curaçao marriage valid in the US and the Netherlands?"
   },
   "a": {
    "nl": "BeachBride meldt dat het in de VS erkend wordt. Curaçao hoort bij het Koninkrijk der Nederlanden en gebruikt het Nederlandse systeem van burgerlijke stand.",
    "en": "BeachBride says it is recognized in the US. Curaçao is part of the Kingdom of the Netherlands and uses a Dutch-style civil registry."
   }
  },
  {
   "q": {
    "nl": "Welke resorts doen bruiloften op Curaçao?",
    "en": "Which resorts host weddings in Curaçao?"
   },
   "a": {
    "nl": "Onder meer Sandals Royal Curaçao, Dreams, Sunscape, Zoetry, Marriott, Renaissance Wind Creek, ACOYA, Baoase, Papagayo en de twee Corendon-resorts bij Mambo Beach.",
    "en": "Among them Sandals Royal Curaçao, Dreams, Sunscape, Zoetry, Marriott, Renaissance Wind Creek, ACOYA, Baoase, Papagayo and the two Corendon resorts at Mambo Beach."
   }
