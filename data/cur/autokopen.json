 "tips": [
  {
   "nl": "Verhuis je naar Curaçao? Eén personenauto per huishouden kan vrij van invoerrecht mee, als je hem minstens een jaar in bezit en gebruik had voor verzending.",
   "en": "Moving to Curaçao? One passenger car per household can come in duty-free if you owned and used it for at least a year before shipping."
  },
  {
   "nl": "Doe de aangifte van je verhuisgoed binnen zes maanden na vestiging, en verkoop of verhuur de auto het eerste jaar niet zonder toestemming van de douane.",
   "en": "File your household goods declaration within six months of settling, and do not sell or rent out the car in the first year without customs approval."
  },
  {
   "nl": "Zonder vrijstelling rekent verscheper SCL met 27% invoerrecht over de CIF-waarde (auto plus verzekering en vracht) plus 9% omzetbelasting.",
   "en": "Without an exemption, shipper SCL quotes 27% import duty on the CIF value (car plus insurance and freight) plus 9% sales tax."
  },
  {
   "nl": "Hybrides: in maart 2026 won een importeur een rechtszaak omdat de inspecteur 27% rekende waar 10% gold. Vraag na welk tarief voor jouw auto geldt.",
   "en": "Hybrids: in March 2026 an importer won a court case because the inspector charged 27% where 10% applied. Ask which rate applies to your car."
  },
  {
   "nl": "Vraag bij de dealer hoe lang onderdelen onderweg zijn: reviews noemen 6 weken voor Nissan en tot 3 maanden voor VW.",
   "en": "Ask the dealer how long parts take to arrive: reviews mention 6 weeks for Nissan and up to 3 months for VW."
  },
  {
   "nl": "Elke auto moet periodiek naar de keuring van het UOVV; een te late keuring kostte eerder een boete van 30 gulden.",
   "en": "Every car has to go through periodic inspection at the UOVV; a late inspection used to carry a 30-guilder fine."
  },
  {
   "nl": "Betaal de jaarlijkse motorrijtuigenbelasting op tijd en haal je nieuwe kentekenplaat op: de politie controleert daar sinds 2026 op.",
   "en": "Pay the annual vehicle tax on time and pick up your new license plate: police have been checking for both since 2026."
  }
 ],
 "faq": [
  {
   "q": {
    "nl": "Waar koop je een nieuwe auto op Curaçao?",
    "en": "Where can you buy a new car in Curaçao?"
   },
   "a": {
    "nl": "De grote merken hebben een eigen dealer: Toyota bij Garage Cordia, Kia en Nissan bij Universal Motors, VW, Audi, Seat en Porsche bij Prowin aan de Seru Loraweg, BMW bij Ultimate Automobiles, Mazda bij Quality Motors en Jeep bij i Cars.",
    "en": "The major brands have their own dealer: Toyota at Garage Cordia, Kia and Nissan at Universal Motors, VW, Audi, Seat and Porsche at Prowin on Seru Loraweg, BMW at Ultimate Automobiles, Mazda at Quality Motors and Jeep at i Cars."
   }
  },
  {
   "q": {
    "nl": "Hoeveel invoerrecht betaal je voor een auto op Curaçao?",
    "en": "How much import duty do you pay on a car in Curaçao?"
   },
   "a": {
    "nl": "Volgens verscheper SCL is dat 27% van de CIF-waarde plus 9% omzetbelasting als de auto korter dan een jaar op je naam staat. Voor sommige voertuigen, zoals bepaalde hybrides, geldt 10%, bleek uit een rechtszaak in maart 2026.",
    "en": "According to shipper SCL, it is 27% of the CIF value plus 9% sales tax if the car has been in your name for less than a year. Some vehicles, such as certain hybrids, fall under 10%, a March 2026 court case found."
   }
  },
  {
   "q": {
    "nl": "Kan ik mijn auto uit Nederland meenemen naar Curaçao?",
    "en": "Can I bring my car from the Netherlands to Curaçao?"
   },
   "a": {
    "nl": "Ja. Als je verhuist, kan één personenauto per huishouden vrij van invoerrecht mee als je hem minstens een jaar in bezit en gebruik had. Je verscheept per container of RoRo, bijvoorbeeld via SCL Rotterdam.",
    "en": "Yes. If you are moving, one passenger car per household can come duty-free if you owned and used it for at least a year. You ship it by container or RoRo, for example through SCL Rotterdam."
   }
  },
  {
   "q": {
    "nl": "Waar koop je een goede occasion op Curaçao?",
    "en": "Where do you buy a good used car in Curaçao?"
   },
   "a": {
    "nl": "Bij occasionhandels zoals Autobedrijf Willemstad (4,6 op Google uit 253 reviews), Occasions@SeriDomi en Economic Auto Center, of particulier via Facebook Marketplace. Bij een particulier laat je de auto beter eerst door een monteur nakijken.",
    "en": "At used-car dealers such as Autobedrijf Willemstad (4.6 on Google from 253 reviews), Occasions@SeriDomi and Economic Auto Center, or from private sellers on Facebook Marketplace. With a private seller, have a mechanic check the car first."
   }
  },
  {
   "q": {
    "nl": "Kun je een elektrische auto kopen op Curaçao?",
    "en": "Can you buy an electric car in Curaçao?"
   },
   "a": {
    "nl": "Ja. All to Car (Veeris) verkoopt elektrische, hybride en plug-in modellen van Chinese merken als Changan, BAW en Dongfeng. Ook Total Motors en Amp Motors richten zich op elektrische auto's.",
    "en": "Yes. All to Car (Veeris) sells electric, hybrid and plug-in models from Chinese brands such as Changan, BAW and Dongfeng. Total Motors and Amp Motors also focus on electric cars."
   }
  },
  {
   "q": {
    "nl": "Kun je een auto leasen op Curaçao?",
    "en": "Can you lease a car in Curaçao?"
   },
   "a": {
    "nl": "Ja, onder meer bij Uralco (Seru Domi) en Autolease Curaçao (F.D. Rooseveltweg). Vraag wat er in de leaseprijs zit, zoals onderhoud en verzekering.",
    "en": "Yes, for example at Uralco (Seru Domi) and Autolease Curaçao (F.D. Rooseveltweg). Ask what the lease price covers, such as maintenance and insurance."
   }
  },
  {
   "q": {
    "nl": "Waar moet een auto op Curaçao gekeurd worden?",
    "en": "Where are cars inspected in Curaçao?"
   },
   "a": {
    "nl": "Bij de keuring van het UOVV (Verkeer en Vervoer) in Willemstad. In januari tot en met april 2026 werden 24.010 voertuigen goedgekeurd, 231 afgekeurd en 11.183 overgeschreven.",
    "en": "At the UOVV (traffic and transport authority) inspection station in Willemstad. From January through April 2026, 24,010 vehicles passed, 231 failed and 11,183 changed owners."
   }
