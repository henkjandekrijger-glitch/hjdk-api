{
  "crons": [
    {
      "path": "/api/hjdk/iterate",
      "schedule": "17 */6 * * *"
    },
    {
      "path": "/api/bol/learn",
      "schedule": "41 */6 * * *"
    },
    {
      "path": "/api/pinterest/post",
      "schedule": "15 6-21 * * *"
    },
    {
      "path": "/api/nl/daily",
      "schedule": "*/15 5-8 * * *"
    },
    {
      "path": "/api/kz/dag",
      "schedule": "*/15 6-8 * * *"
    },
    {
      "path": "/api/kz/trends",
      "schedule": "20 4 * * *"
    },
    {
      "path": "/api/kz/pushwatch",
      "schedule": "5 9 * * *"
    },
    {
      "path": "/api/kz/opruimen",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/kz/indexnow",
      "schedule": "35 6 * * *"
    },
    {
      "path": "/api/kzmaak/signalen",
      "schedule": "50 2 * * *"
    },
    {
      "path": "/api/kzmaak/dag",
      "schedule": "*/10 3-12 * * *"
    },
    {
      "path": "/api/kz/dealsrefresh",
      "schedule": "25 */3 * * *"
    },
    {
      "path": "/api/md/ronde",
      "schedule": "7 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/pinterest.csv",
      "destination": "/api/kz?op=pincsv"
    },
    {
      "source": "/api/md/:op",
      "destination": "/api/md?op=:op"
    },
    {
      "source": "/pin/:p",
      "destination": "/api/pin?p=:p"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/kz?op=rss"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/kz?op=rss"
    },
    {
      "source": "/pinterest.xml",
      "destination": "/api/kz?op=pinfeed"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/kz?op=llmsfull"
    },
    {
      "source": "/466971cbc1bbe43e6bb64a94465e4470.txt",
      "destination": "/api/kz?op=indexnowkey"
    },
    {
      "source": "/categorie/:c",
      "destination": "/api/kz?op=cat&c=:c"
    },
    {
      "source": "/keuzehulp/categorie/:c",
      "destination": "/api/kz?op=cat&c=:c"
    },
    {
      "source": "/sw.js",
      "destination": "/api/kz?op=sw"
    },
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/setup",
      "destination": "/api/setup"
    },
    {
      "source": "/keuzehulp",
      "destination": "/api/kz"
    },
    {
      "source": "/keuzehulp/sitemap.xml",
      "destination": "/api/kz?op=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/kz?op=robots"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/kz?op=llms"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/kz?op=sitemap"
    },
    {
      "source": "/keuzehulp/:slug",
      "destination": "/api/kz?slug=:slug"
    },
    {
      "source": "/api/kzmaak/:op",
      "destination": "/api/kzmaak?op=:op"
    },
    {
      "source": "/api/kz/:op",
      "destination": "/api/kz?op=:op"
    },
    {
      "source": "/leads",
      "destination": "/api/lc?op=leads"
    },
    {
      "source": "/subs",
      "destination": "/api/nl?op=subs"
    },
    {
      "source": "/api/nl/:op",
      "destination": "/api/nl?op=:op"
    },
    {
      "source": "/api/lc/:op",
      "destination": "/api/lc?op=:op"
    },
    {
      "source": "/pins",
      "destination": "/api/pinterest?op=pins"
    },
    {
      "source": "/api/pinterest/:op",
      "destination": "/api/pinterest?op=:op"
    },
    {
      "source": "/api/bol/:op",
      "destination": "/api/bol?op=:op"
    },
    {
      "source": "/api/amz/:op",
      "destination": "/api/amz?op=:op"
    },
    {
      "source": "/:slug([a-z0-9-]+)",
      "has": [
        {
          "type": "host",
          "value": "(?!hjdk-api\\.vercel\\.app).*"
        }
      ],
      "destination": "/api/kz?slug=:slug"
    },
    {
      "source": "/t/:page",
      "destination": "/api/t?page=:page"
    },
    {
      "source": "/b/:slug",
      "destination": "/api/b?slug=:slug"
    },
    {
      "source": "/api/hjdk/stats/:rest*",
      "destination": "/api/hjdk/stats?p=:rest*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type,x-hjdk-token"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/kz.js": {
      "maxDuration": 60
    },
    "api/kzmaak.js": {
      "maxDuration": 300
    },
    "api/pin.js": {
      "maxDuration": 30
    },
    "api/md.js": {
      "maxDuration": 300
    }
  }
}